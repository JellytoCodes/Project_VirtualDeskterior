  productList:
  - productID: DESK_0001
    productName: "\uBBF8\uB2C8\uBA40 \uD654\uC774\uD2B8 \uB370\uC2A4\uD06C"
    category: "\uCC45\uC0C1"
    price: "\u20A9299,000"
    description: "\uAE54\uB054\uD55C \uB370\uC2A4\uD06C \uC138\uD305\uC744 \uC704\uD55C \uBBF8\uB2C8\uBA40 \uD654\uC774\uD2B8 \uCC45\uC0C1\uC785\uB2C8\uB2E4. AR \uBC30\uCE58\uB85C \uACF5\uAC04 \uD06C\uAE30\uC640 \uC0C9\uAC10\uC744 \uBA3C\uC800 \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    dimensions: "120cm \xD7 60cm \xD7 75cm"
    material: "\uD654\uC774\uD2B8 \uC624\uD06C \uD328\uB110"
    productImage: {fileID: 7681201850867341242, guid: 215687feeab0b7445b4a1cd86c82c2e1, type: 3}
    arModelPrefab: {fileID: 6587345871612521942, guid: e31015a6cb5368449a94f0d54981ce03, type: 3}
  - productID: CHAIR_0001
    productName: "\uBAA8\uB358 \uC624\uD53C\uC2A4 \uCCB4\uC5B4"
    category: "\uC758\uC790"
    price: "\u20A9189,000"
    description: "\uC7A5\uC2DC\uAC04 \uC791\uC5C5\uC5D0 \uB9DE\uCDB0 \uB4F1\uBC1B\uC774\uC640 \uC88C\uBA74\uC744 \uACE0\uB824\uD55C \uB370\uC2A4\uD06C\uC6A9 \uC758\uC790\uC785\uB2C8\uB2E4. \uAD6C\uB9E4 \uC804 \uCC45\uC0C1\uACFC\uC758 \uBE44\uB840\uB97C \uD655\uC778\uD558\uB294 \uC2DC\uB098\uB9AC\uC624\uC5D0 \uC801\uD569\uD569\uB2C8\uB2E4."
    dimensions: "65cm \xD7 65cm \xD7 110cm"
    material: "\uBA54\uC2DC \uC6D0\uB2E8, \uC2A4\uD2F8 \uD504\uB808\uC784"
    productImage: {fileID: 7681201850867341242, guid: 215687feeab0b7445b4a1cd86c82c2e1, type: 3}
    arModelPrefab: {fileID: 6587345871612521942, guid: e31015a6cb5368449a94f0d54981ce03, type: 3}
  - productID: MONITOR_0001
    productName: "\uBAA8\uB2C8\uD130 \uBC1B\uCE68\uB300"
    category: "\uBAA8\uB2C8\uD130"
    price: "\u20A949,000"
    description: "\uBAA8\uB2C8\uD130 \uB192\uC774\uB97C \uC62C\uB824 \uC2DC\uC120\uC744 \uC815\uB9AC\uD558\uACE0 \uD558\uBD80 \uC218\uB0A9\uACF5\uAC04\uC744 \uD655\uBCF4\uD558\uB294 \uC18C\uD615 \uB370\uC2A4\uD06C \uC544\uC774\uD15C\uC785\uB2C8\uB2E4."
    dimensions: "55cm \xD7 22cm \xD7 10cm"
    material: "\uC6B0\uB4DC \uD328\uB110, \uBBF8\uB044\uB7FC \uBC29\uC9C0 \uD328\uB4DC"
    productImage: {fileID: 7681201850867341242, guid: 215687feeab0b7445b4a1cd86c82c2e1, type: 3}
    arModelPrefab: {fileID: 6587345871612521942, guid: e31015a6cb5368449a94f0d54981ce03, type: 3}
  - productID: LIGHT_0001
    productName: "\uC2EC\uD50C \uB370\uC2A4\uD06C \uC870\uBA85"
    category: "\uC870\uBA85"
    price: "\u20A989,000"
    description: "\uC791\uC5C5 \uACF5\uAC04\uC758 \uBC1D\uAE30\uC640 \uBD84\uC704\uAE30\uB97C \uBC14\uAFB8\uB294 \uBBF8\uB2C8\uBA40 \uC870\uBA85\uC785\uB2C8\uB2E4. \uB370\uC2A4\uD06C \uC88C\uCE21/\uC6B0\uCE21 \uBC30\uCE58 \uBE44\uAD50\uC5D0 \uC801\uD569\uD569\uB2C8\uB2E4."
    dimensions: "18cm \xD7 18cm \xD7 42cm"
    material: "\uC54C\uB8E8\uBBF8\uB284, LED \uBAA8\uB4C8"
    productImage: {fileID: 7681201850867341242, guid: 215687feeab0b7445b4a1cd86c82c2e1, type: 3}
    arModelPrefab: {fileID: 6587345871612521942, guid: e31015a6cb5368449a94f0d54981ce03, type: 3}
  - productID: STORAGE_0001
    productName: "\uC6B0\uB4DC \uB370\uC2A4\uD06C \uC218\uB0A9\uD568"
    category: "\uC218\uB0A9"
    price: "\u20A939,000"
    description: "\uB370\uC2A4\uD06C \uC704 \uC7A1\uD654\uB97C \uC815\uB9AC\uD558\uAE30 \uC704\uD55C \uC18C\uD615 \uC218\uB0A9\uD568\uC785\uB2C8\uB2E4. \uCC45\uC0C1 \uB108\uBE44\uC5D0 \uB9DE\uB294\uC9C0 \uC0AC\uC804 \uD655\uC778\uD558\uB294 \uC6A9\uB3C4\uB85C \uBCF4\uC5EC\uC904 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    dimensions: "28cm \xD7 18cm \xD7 12cm"
    material: "\uC624\uD06C \uBB34\uB2AC \uD569\uD310"
    productImage: {fileID: 7681201850867341242, guid: 215687feeab0b7445b4a1cd86c82c2e1, type: 3}
    arModelPrefab: {fileID: 6587345871612521942, guid: e31015a6cb5368449a94f0d54981ce03, type: 3}
  - productID: PROPS_0001
    productName: "\uBBF8\uB2C8\uBA40 \uD654\uBD84"
    category: "\uC18C\uD488"
    price: "\u20A922,000"
    description: "\uD5C8\uC804\uD55C \uCC45\uC0C1\uC5D0 \uD3EC\uC778\uD2B8\uB97C \uC8FC\uB294 \uC791\uC740 \uD654\uBD84\uC785\uB2C8\uB2E4. \uC791\uC740 \uC0C1\uD488\uC77C\uC218\uB85D \uC2E4\uC81C \uCC45\uC0C1 \uC704 \uBE44\uB840 \uD655\uC778\uC774 \uC911\uC694\uD558\uB2E4\uB294 \uCEE8\uC149\uD2B8\uC5D0 \uC798 \uB9DE\uC2B5\uB2C8\uB2E4."
    dimensions: "12cm \xD7 12cm \xD7 18cm"
    material: "\uC138\uB77C\uBBF9 \uD654\uBD84, \uC778\uC870 \uC2DD\uBB3C"
    productImage: {fileID: 7681201850867341242, guid: 215687feeab0b7445b4a1cd86c82c2e1, type: 3}
    arModelPrefab: {fileID: 6587345871612521942, guid: e31015a6cb5368449a94f0d54981ce03, type: 3}
  - productID: PROPS_0002
    productName: "\uC2EC\uD50C \uD39C \uD2B8\uB808\uC774"
    category: "\uC18C\uD488"
    price: "\u20A916,000"
    description: "\uD39C, \uD074\uB9BD, \uC791\uC740 \uC18C\uD488\uC744 \uD55C\uACF3\uC5D0 \uBAA8\uC544\uB450\uB294 \uB370\uC2A4\uD06C \uD2B8\uB808\uC774\uC785\uB2C8\uB2E4."
    dimensions: "24cm \xD7 10cm \xD7 3cm"
    material: "\uBB34\uAD11 \uD50C\uB77C\uC2A4\uD2F1"
    productImage: {fileID: 7681201850867341242, guid: 215687feeab0b7445b4a1cd86c82c2e1, type: 3}
    arModelPrefab: {fileID: 6587345871612521942, guid: e31015a6cb5368449a94f0d54981ce03, type: 3}
  - productID: DESK_0002
    productName: "\uD398\uBE0C\uB9AD \uB370\uC2A4\uD06C \uB9E4\uD2B8"
    category: "\uCC45\uC0C1"
    price: "\u20A935,000"
    description: "\uD0A4\uBCF4\uB4DC\uC640 \uB9C8\uC6B0\uC2A4 \uD65C\uC6A9 \uC601\uC5ED\uC744 \uC815\uB9AC\uD558\uB294 \uB370\uC2A4\uD06C \uB9E4\uD2B8\uC785\uB2C8\uB2E4. \uAD6C\uB9E4 \uC804 \uCC45\uC0C1 \uC704 \uACF5\uAC04 \uCC28\uC9C0\uB97C \uBE44\uAD50\uD558\uAE30 \uC88B\uC2B5\uB2C8\uB2E4."
